# Settings for scripts/*.sh, the connector configs and tests/test_cdc.py.
#
# One file per environment, picked with APP_ENV (default local):
#
#   APP_ENV=local        .env.local        local docker-compose stack     (section 1)
#   APP_ENV=development  .env.development  *.kodehive.id / *.kafka.kodehive.id (section 2)
#   APP_ENV=staging      .env.staging      staging                        (section 3)
#
#   cp .env.example .env.local          # section 1 works as is; set the passwords
#   cp .env.example .env.development    # then comment section 1 and uncomment section 2
#   APP_ENV=development bash scripts/register-connectors.sh --dry-run
#
# scripts/env.sh reads the file (ENV_FILE=<file> picks another one) and fills in
# every default listed in section 1. A variable set in the shell wins over the
# file. Format: one VAR=value per line, no quotes, no comments after values;
# values are read literally ($ is fine in passwords, a single quote is not).
# All .env* files except this one are git-ignored.


# =============================================================================
# 1. LOCAL: docker-compose stack on this machine (.env.local)
# =============================================================================
# Only the two passwords are needed; everything else defaults to the local
# stack. The full list of settings, with their defaults, follows.

# SQL Server sa password (must meet SQL Server's complexity rules) and the
# PostgreSQL superuser password. docker-compose creates the databases with them.
MSSQL_PASSWORD=change_me
PG_PASSWORD=change_me

# ---- Databases, as reached from this machine (setup-db.sh, tests)
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_DB=bpjsk_poc
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=bpjsk_poc

# ---- Databases and broker, as reached from the Kafka Connect worker.
# Default: MSSQL_HOST / MSSQL_PORT (PG_*) when those are set, else the compose
# service names sqlserver:1433 / postgres:5432.
# CONNECT_MSSQL_HOST=
# CONNECT_MSSQL_PORT=
# CONNECT_PG_HOST=
# CONNECT_PG_PORT=
# Broker for the SQL Server source's schema history.
# CONNECT_KAFKA_BOOTSTRAP=kafka:29092

# ---- Logins
# Admins: run setup-db.sh (create schema, CDC, triggers, logins); the tests
# write as them. MSSQL_PASSWORD / PG_PASSWORD are theirs.
# MSSQL_ADMIN_USER=sa
# PG_ADMIN_USER=postgres
# Debezium sources (read only; the PostgreSQL one needs REPLICATION).
# Passwords default to MSSQL_PASSWORD / PG_PASSWORD.
# MSSQL_USER=sa
# MSSQL_USER_PASSWORD=
# PG_USER=debezium_replication
# PG_USER_PASSWORD=
# JDBC sinks (setup-db.sh creates them). The loop filter drops every change
# these logins write, so nothing else may use them. They must differ from the
# admins (and, for PostgreSQL, from PG_USER). Passwords default to
# MSSQL_PASSWORD / PG_PASSWORD.
# MSSQL_SINK_USER=cdc_sink
# MSSQL_SINK_PASSWORD=
# PG_SINK_USER=cdc_sink
# PG_SINK_PASSWORD=
# Where the sinks write; defaults to the source databases.
# MSSQL_SINK_HOST=
# MSSQL_SINK_PORT=
# MSSQL_SINK_DB=
# PG_SINK_HOST=
# PG_SINK_PORT=
# PG_SINK_DB=

# ---- Endpoints (user/password only for basic auth)
# CONNECT_URL=http://localhost:8083
# CONNECT_USER=
# CONNECT_PWD=
# KSQLDB_URL=http://localhost:8088
# KSQLDB_USER=
# KSQLDB_PASSWORD=
# Broker as reached from this machine (tests only).
# KAFKA_BOOTSTRAP=localhost:9092
# inline: passwords are written into the connector configs (readable by anyone
# with access to the Connect REST API). worker: configs keep ${env:...} and the
# Connect worker must have those variables (the local compose sets them).
# CONNECT_SECRETS=inline


# =============================================================================
# 2. DEVELOPMENT: *.kodehive.id databases, shared Kafka at *.kafka.kodehive.id
#    (.env.development)
# =============================================================================
# Uncomment in .env.development (and comment out section 1's passwords).
# The Connect worker is shared with other teams: keep CONNECT_SECRETS=inline,
# like the other connectors on it. The tests need --allow-remote here.

# MSSQL_HOST=sqlserver.kodehive.id
# MSSQL_PORT=6978
# MSSQL_DB=bpjsk_poc
# MSSQL_PASSWORD=<sa password>
#
# PG_HOST=postgres.kodehive.id
# PG_PORT=6969
# PG_DB=bpjsk_poc
# PG_ADMIN_USER=developer
# PG_PASSWORD=<developer password>
#
# Sink logins: dedicated, never the admin (developer) or an app login.
# MSSQL_SINK_USER=cdc_sink
# MSSQL_SINK_PASSWORD=<cdc_sink password>
# PG_SINK_USER=cdc_sink
# PG_SINK_PASSWORD=<cdc_sink password>
#
# CONNECT_URL=https://connect.kafka.kodehive.id
# CONNECT_USER=<connect user>
# CONNECT_PWD=<connect password>
# KSQLDB_URL=https://ksqldb.kafka.kodehive.id
# CONNECT_SECRETS=inline
# Schema-history broker as the worker reaches it (what the running
# bpjsk-mssql-source uses).
# CONNECT_KAFKA_BOOTSTRAP=kafka:29092
# Broker as reached from this machine (tests only).
# KAFKA_BOOTSTRAP=kafka.kodehive.id:9092


# =============================================================================
# 3. STAGING (.env.staging)
# =============================================================================
# Uncomment in .env.staging and replace every <...>. Same rules as development:
# dedicated sink logins, CONNECT_SECRETS=inline on a shared worker, and
# --allow-remote for the tests (they insert and delete CDCT* rows; prefer not
# to run them on staging at all).

# MSSQL_HOST=<staging SQL Server host>
# MSSQL_PORT=1433
# MSSQL_DB=bpjsk_poc
# MSSQL_ADMIN_USER=sa
# MSSQL_PASSWORD=<admin password>
#
# PG_HOST=<staging PostgreSQL host>
# PG_PORT=5432
# PG_DB=bpjsk_poc
# PG_ADMIN_USER=<table owner>
# PG_PASSWORD=<table owner password>
#
# MSSQL_SINK_USER=cdc_sink
# MSSQL_SINK_PASSWORD=<cdc_sink password>
# PG_SINK_USER=cdc_sink
# PG_SINK_PASSWORD=<cdc_sink password>
#
# CONNECT_URL=https://<staging connect host>
# CONNECT_USER=<connect user>
# CONNECT_PWD=<connect password>
# KSQLDB_URL=https://<staging ksqldb host>
# CONNECT_SECRETS=inline
# CONNECT_KAFKA_BOOTSTRAP=<broker as the Connect worker reaches it>
# KAFKA_BOOTSTRAP=<broker as this machine reaches it>
