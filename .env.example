MSSQL_PASSWORD=change_me
PG_PASSWORD=change_me
# Logins the JDBC sinks write with (scripts/setup-db.sh creates them). The
# loop filter drops every change these logins make, so don't use them for apps.
# Passwords default to MSSQL_PASSWORD / PG_PASSWORD; no single quotes.
# MSSQL_SINK_USER=cdc_sink
# MSSQL_SINK_PASSWORD=
# PG_SINK_USER=cdc_sink
# PG_SINK_PASSWORD=
