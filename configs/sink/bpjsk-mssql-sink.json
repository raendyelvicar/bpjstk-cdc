{
    "name": "bpjsk-mssql-sink",
    "config": {
        "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
        "tasks.max": "2",
        "topics": "pg-bpjsk-cdc.public.bpjs_claim.to-mssql,pg-bpjsk-cdc.public.bpjs_membership.to-mssql,pg-bpjsk-cdc.public.bpjs_monthly_contribution.to-mssql",
        "connection.url": "jdbc:sqlserver://sqlserver:1433;databaseName=bpjsk_poc;encrypt=false",
        "connection.username": "${env:MSSQL_SINK_USER}",
        "connection.password": "${env:MSSQL_SINK_PASSWORD}",
        "insert.mode": "upsert",
        "primary.key.mode": "record_key",
        "delete.enabled": "true",
        "schema.evolution": "none",
        "quote.identifiers": "true",
        "dialect.sqlserver.identity.insert": "true",
        "collection.name.format": "dbo.${topic}",
        "errors.tolerance": "all",
        "errors.log.enable": "true",
        "errors.deadletterqueue.topic.name": "dlq.bpjsk-replication",
        "errors.deadletterqueue.topic.replication.factor": "1",
        "errors.deadletterqueue.context.headers.enable": "true",
        "transforms": "unwrap,dropLogin,routeClaim,routeMembership,routeContribution,renameClaimValue,renameClaimKey,renameMembershipValue,renameMembershipKey,renameContributionValue,renameContributionKey",
        "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
        "transforms.unwrap.delete.tombstone.handling.mode": "tombstone",
        "transforms.dropLogin.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.dropLogin.exclude": "db_login",
        "transforms.routeClaim.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeClaim.regex": "pg-bpjsk-cdc\\.public\\.bpjs_claim\\.to-mssql",
        "transforms.routeClaim.replacement": "BPJSClaim",
        "transforms.routeMembership.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeMembership.regex": "pg-bpjsk-cdc\\.public\\.bpjs_membership\\.to-mssql",
        "transforms.routeMembership.replacement": "BPJSMembership",
        "transforms.routeContribution.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeContribution.regex": "pg-bpjsk-cdc\\.public\\.bpjs_monthly_contribution\\.to-mssql",
        "transforms.routeContribution.replacement": "BPJSMonthlyContribution",
        "predicates": "isClaim,isMembership,isContribution",
        "predicates.isClaim.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
        "predicates.isClaim.pattern": "BPJSClaim",
        "predicates.isMembership.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
        "predicates.isMembership.pattern": "BPJSMembership",
        "predicates.isContribution.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
        "predicates.isContribution.pattern": "BPJSMonthlyContribution",
        "transforms.renameClaimValue.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.renameClaimValue.renames": "claim_id:ClaimID,membership_id:MembershipID,claim_number:ClaimNumber,program_type:ProgramType,claim_date:ClaimDate,reason_description:ReasonDescription,disbursed_amount:DisbursedAmount,claim_status:ClaimStatus,approved_at:ApprovedAt,created_at:CreatedAt",
        "transforms.renameClaimValue.predicate": "isClaim",
        "transforms.renameClaimKey.type": "org.apache.kafka.connect.transforms.ReplaceField$Key",
        "transforms.renameClaimKey.renames": "claim_id:ClaimID",
        "transforms.renameClaimKey.predicate": "isClaim",
        "transforms.renameMembershipValue.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.renameMembershipValue.renames": "membership_id:MembershipID,employee_id:EmployeeID,bpjs_number:BPJSNumber,nik:NIK,full_name:FullName,enrollment_date:EnrollmentDate,work_risk_group:WorkRiskGroup,is_active:IsActive,created_at:CreatedAt",
        "transforms.renameMembershipValue.predicate": "isMembership",
        "transforms.renameMembershipKey.type": "org.apache.kafka.connect.transforms.ReplaceField$Key",
        "transforms.renameMembershipKey.renames": "membership_id:MembershipID",
        "transforms.renameMembershipKey.predicate": "isMembership",
        "transforms.renameContributionValue.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.renameContributionValue.exclude": "total_amount",
        "transforms.renameContributionValue.renames": "contribution_id:ContributionID,membership_id:MembershipID,period_month:PeriodMonth,period_year:PeriodYear,base_wage:BaseWage,jht_employee:JHTEmployee,jht_employer:JHTEmployer,jkk_employer:JKKEmployer,jkm_employer:JKMEmployer,jp_employee:JPEmployee,jp_employer:JPEmployer,payment_status:PaymentStatus,paid_at:PaidAt,created_at:CreatedAt",
        "transforms.renameContributionValue.predicate": "isContribution",
        "transforms.renameContributionKey.type": "org.apache.kafka.connect.transforms.ReplaceField$Key",
        "transforms.renameContributionKey.renames": "contribution_id:ContributionID",
        "transforms.renameContributionKey.predicate": "isContribution",
        "key.converter": "org.apache.kafka.connect.json.JsonConverter",
        "key.converter.schemas.enable": "true",
        "value.converter": "org.apache.kafka.connect.json.JsonConverter",
        "value.converter.schemas.enable": "true",
        "NOTE transforms.unwrap.delete.tombstone.handling.mode": "Deletes reach the sink as a minimal delete envelope (no columns) that ksqlDB (sql/ksqldb-01-loop-filter.sql) writes in place of each delete event; \"tombstone\" mode flattens it to a null value with an empty schema, which the sink runs as DELETE by key. Real tombstones would be DROPPED by this mode (silently, no DLQ), and the original delete envelope would make the sink try to ALTER the table and retry forever. Same on Debezium 2.5.4, 2.6.2 and 3.6.3.",
        "NOTE connection.username": "Dedicated sink login (cdc_sink by default, created by scripts/setup-db.sh). The LWW triggers stamp db_login with the connecting login on every write, and the ksqlDB loop filter drops changes whose db_login is this login, so rows the sink writes are not sent back. Never use the admin login here. dropLogin keeps the origin's db_login off the wire; the target's trigger sets its own."
    }
}