{
    "name": "mssql-sink-orders",
    "config": {
        "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
        "tasks.max": "2",
        "topics": "pg-cdc.public.orders,pg-cdc.public.customers,pg-cdc.public.products,pg-cdc.public.transactions",
        "connection.url": "jdbc:sqlserver://sqlserver:1433;databaseName=ProductionDB;encrypt=false",
        "connection.username": "sa",
        "connection.password": "${env:MSSQL_PASSWORD}",
        "insert.mode": "upsert",
        "primary.key.mode": "record_key",
        "delete.enabled": "true",
        "schema.evolution": "none",
        "quote.identifiers": "true",
        "collection.name.format": "dbo.${topic}",
        "errors.tolerance": "all",
        "errors.log.enable": "true",
        "errors.deadletterqueue.topic.name": "dlq.orders-replication",
        "errors.deadletterqueue.topic.replication.factor": "1",
        "errors.deadletterqueue.context.headers.enable": "true",
        "predicates": "isOrders",
        "predicates.isOrders.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
        "predicates.isOrders.pattern": "Orders",
        "transforms": "filterLoop,unwrap,routeOrders,routeCustomers,routeProducts,routeTransactions,renameOrdersValue,renameOrdersKey",
        "transforms.filterLoop.type": "io.debezium.transforms.Filter",
        "transforms.filterLoop.language": "jsr223.groovy",
        "transforms.filterLoop.condition": "value == null || value.after == null || value.after.last_updated_by != 'MSSQL_NODE_01'",
        "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
        "transforms.unwrap.delete.tombstone.handling.mode": "delete-to-tombstone",
        "transforms.routeOrders.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeOrders.regex": "pg-cdc\\.public\\.orders",
        "transforms.routeOrders.replacement": "Orders",
        "transforms.routeCustomers.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeCustomers.regex": "pg-cdc\\.public\\.customers",
        "transforms.routeCustomers.replacement": "Customers",
        "transforms.routeProducts.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeProducts.regex": "pg-cdc\\.public\\.products",
        "transforms.routeProducts.replacement": "Products",
        "transforms.routeTransactions.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeTransactions.regex": "pg-cdc\\.public\\.transactions",
        "transforms.routeTransactions.replacement": "Transactions",
        "transforms.renameOrdersValue.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
        "transforms.renameOrdersValue.renames": "orderid:OrderID,customerid:CustomerID,orderstatus:OrderStatus,ordertotal:OrderTotal",
        "transforms.renameOrdersValue.predicate": "isOrders",
        "transforms.renameOrdersKey.type": "org.apache.kafka.connect.transforms.ReplaceField$Key",
        "transforms.renameOrdersKey.renames": "orderid:OrderID",
        "transforms.renameOrdersKey.predicate": "isOrders"
    }
}
