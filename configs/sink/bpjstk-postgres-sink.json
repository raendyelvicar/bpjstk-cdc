{
    "name": "postgres-sink-orders",
    "config": {
        "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
        "tasks.max": "2",
        "topics": "mssql-cdc.ProductionDB.dbo.Orders,mssql-cdc.ProductionDB.dbo.Customers,mssql-cdc.ProductionDB.dbo.Products,mssql-cdc.ProductionDB.dbo.Transactions",
        "connection.url": "jdbc:postgresql://postgres:5432/ProductionDB?stringtype=unspecified",
        "connection.username": "postgres",
        "connection.password": "${env:PG_PASSWORD}",
        "insert.mode": "upsert",
        "primary.key.mode": "record_key",
        "delete.enabled": "true",
        "schema.evolution": "none",
        "collection.name.format": "${topic}",
        "errors.tolerance": "all",
        "errors.log.enable": "true",
        "errors.deadletterqueue.topic.name": "dlq.orders-replication",
        "errors.deadletterqueue.topic.replication.factor": "1",
        "errors.deadletterqueue.context.headers.enable": "true",
        "transforms": "filterLoop,routeOrders,routeCustomers,routeProducts,routeTransactions",
        "transforms.filterLoop.type": "io.debezium.transforms.Filter",
        "transforms.filterLoop.language": "jsr223.groovy",
        "transforms.filterLoop.condition": "value == null || value.after == null || value.after.last_updated_by != 'PG_NODE_01'",
        "transforms.routeOrders.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeOrders.regex": "mssql-cdc\\.ProductionDB\\.dbo\\.Orders",
        "transforms.routeOrders.replacement": "orders",
        "transforms.routeCustomers.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeCustomers.regex": "mssql-cdc\\.ProductionDB\\.dbo\\.Customers",
        "transforms.routeCustomers.replacement": "customers",
        "transforms.routeProducts.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeProducts.regex": "mssql-cdc\\.ProductionDB\\.dbo\\.Products",
        "transforms.routeProducts.replacement": "products",
        "transforms.routeTransactions.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.routeTransactions.regex": "mssql-cdc\\.ProductionDB\\.dbo\\.Transactions",
        "transforms.routeTransactions.replacement": "transactions"
    }
}
