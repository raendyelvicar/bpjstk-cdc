{
    "name": "bpjsk-postgres-source",
    "config": {
        "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
        "tasks.max": "1",
        "database.hostname": "${env:CONNECT_PG_HOST}",
        "database.port": "${env:CONNECT_PG_PORT}",
        "database.user": "${env:PG_USER}",
        "database.password": "${env:PG_USER_PASSWORD}",
        "database.dbname": "${env:PG_DB}",
        "plugin.name": "pgoutput",
        "publication.name": "dbz_publication",
        "slot.name": "debezium_pg_slot",
        "topic.prefix": "pg-bpjsk-cdc",
        "table.include.list": "public.bpjs_claim,public.bpjs_membership,public.bpjs_monthly_contribution",
        "tombstones.on.delete": "true",
        "decimal.handling.mode": "double",
        "publication.autocreate.mode": "disabled",
        "key.converter": "org.apache.kafka.connect.json.JsonConverter",
        "key.converter.schemas.enable": "true",
        "value.converter": "org.apache.kafka.connect.json.JsonConverter",
        "value.converter.schemas.enable": "true"
    }
}